      {
        "parameters": {
          "jsCode": "// 1. Grab the text from the Gemini output\nconst rawText = $input.first().json.content.parts[0].text;\n\n// 2. Clean out any potential markdown \"backticks\" Gemini might have added\nconst cleanJsonString = rawText.replace(/```json|```/g, \"\").trim();\n\ntry {\n  // 3. Turn the string into a real JSON object\n  const parsedData = JSON.parse(cleanJsonString);\n  \n  // 4. Return it so n8n can see the fields\n  return parsedData;\n} catch (error) {\n  throw new Error(\"Gemini did not return valid JSON. Check the model output.\");\n}"
        },
